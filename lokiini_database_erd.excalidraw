    {
      "id": "text_329504",
      "type": "text",
      "x": 76,
      "y": 792,
      "width": 382.8,
      "height": 16.2,
      "angle": 0,
      "strokeColor": "#D9480F",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
