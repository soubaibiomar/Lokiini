    {
      "id": "text_112_8813",
      "type": "text",
      "x": 1099,
      "y": 1638,
      "width": 347.99999999999994,
      "height": 81.00000000000001,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "seed": 585627,
      "version": 1,
      "versionNonce": 436116,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787826153,
      "link": null,
      "locked": false,
      "text": "• L'utilisateur clique sur 'Réserver' ou 'Publier'\n• Le frontend détecte 'is_kyc_verified == False'\n• Ouverture automatique de la KYCVerificationModal\n• Saisie de la CIN et ouverture flux caméra\n• Envoi des données au module ML Biométrie",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• L'utilisateur clique sur 'Réserver' ou 'Publier'\n• Le frontend détecte 'is_kyc_verified == False'\n• Ouverture automatique de la KYCVerificationModal\n• Saisie de la CIN et ouverture flux caméra\n• Envoi des données au module ML Biométrie",
      "lineHeight": 1.35,
      "frameId": null
    },
