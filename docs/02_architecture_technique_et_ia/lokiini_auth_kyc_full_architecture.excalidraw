      "version": 1,
      "versionNonce": 508621,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787826153,
      "link": null,
      "locked": false,
      "text": "• UC-14 : Détection de vivacité faciale anti-deepfake (ISO 30107-3)\n• UC-15 : Extraction OCR et validation syntaxique préfectorale CIN\n• UC-16 : Émission du certificat Zero-Knowledge (Loi n° 09-08)\n• UC-17 : Purge cryptographique irréversible des flux vidéo de la RAM\n• UC-18 : Audit journalier automatisé des accès et consentements",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• UC-14 : Détection de vivacité faciale anti-deepfake (ISO 30107-3)\n• UC-15 : Extraction OCR et validation syntaxique préfectorale CIN\n• UC-16 : Émission du certificat Zero-Knowledge (Loi n° 09-08)\n• UC-17 : Purge cryptographique irréversible des flux vidéo de la RAM\n• UC-18 : Audit journalier automatisé des accès et consentements",
      "lineHeight": 1.35,
      "frameId": null
