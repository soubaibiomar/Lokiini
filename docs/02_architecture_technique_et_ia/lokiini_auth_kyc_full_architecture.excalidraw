    {
      "id": "text_87_8352",
      "type": "text",
      "x": 1844,
      "y": 838,
      "width": 528.9599999999999,
      "height": 210.60000000000002,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "seed": 469888,
      "version": 1,
      "versionNonce": 289912,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787826153,
      "link": null,
      "locked": false,
      "text": "Relations 1-to-N issues de 'users' :\n\n  [users.id] (Propriétaire) ──< 1 : N >─── [equipment.owner_id]\n  └─ Un loueur possède N équipements, avec tarifs MAD et caution.\n\n  [users.id] (Locataire)    ──< 1 : N >─── [bookings.renter_id]\n  └─ Un locataire certifié KYC peut créer N réservations sous séquestre CMI.\n\n  [users.id]                ──< 1 : N >─── [inspections.inspector_id]\n  └─ Signature de l'état des lieux d'entrée et de sortie contradictoire.\n\n  [users.id]                ──< 1 : N >─── [cndp_audit_logs.user_id]\n  └─ Traçabilité juridique CNDP horodatée RFC 3161.",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Relations 1-to-N issues de 'users' :\n\n  [users.id] (Propriétaire) ──< 1 : N >─── [equipment.owner_id]\n  └─ Un loueur possède N équipements, avec tarifs MAD et caution.\n\n  [users.id] (Locataire)    ──< 1 : N >─── [bookings.renter_id]\n  └─ Un locataire certifié KYC peut créer N réservations sous séquestre CMI.\n\n  [users.id]                ──< 1 : N >─── [inspections.inspector_id]\n  └─ Signature de l'état des lieux d'entrée et de sortie contradictoire.\n\n  [users.id]                ──< 1 : N >─── [cndp_audit_logs.user_id]\n  └─ Traçabilité juridique CNDP horodatée RFC 3161.",
      "lineHeight": 1.35,
      "frameId": null
    },
