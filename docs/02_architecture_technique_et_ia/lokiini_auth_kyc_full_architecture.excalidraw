    {
      "id": "text_22_9798",
      "type": "text",
      "x": 79,
      "y": 938,
      "width": 417.59999999999997,
      "height": 178.20000000000005,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "seed": 338757,
      "version": 1,
      "versionNonce": 170356,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787826153,
      "link": null,
      "locked": false,
      "text": "1. ANONYME (Visiteur non connecté) :\n   ➔ Consultation catalogue, filtres villes, détails machine\n2. INSCRIT_NON_VÉRIFIÉ (Role: Renter / Owner) :\n   ➔ Accès dashboard, création brouillons annonces\n   ➔ Bloqué pour réservation ferme ou signature de bail\n3. KYC_EN_COURS (Upload selfie + CIN) :\n   ➔ Traitement ML éphémère (temps réel < 1.2s)\n4. KYC_CERTIFIÉ (is_kyc_verified = True) :\n   ➔ Déblocage séquestre caution CMI & baux juridiques\n5. SUSPENDU (Liveness échec / Fraude avérée) :\n   ➔ Révocation des accès et signalement audit CNDP",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. ANONYME (Visiteur non connecté) :\n   ➔ Consultation catalogue, filtres villes, détails machine\n2. INSCRIT_NON_VÉRIFIÉ (Role: Renter / Owner) :\n   ➔ Accès dashboard, création brouillons annonces\n   ➔ Bloqué pour réservation ferme ou signature de bail\n3. KYC_EN_COURS (Upload selfie + CIN) :\n   ➔ Traitement ML éphémère (temps réel < 1.2s)\n4. KYC_CERTIFIÉ (is_kyc_verified = True) :\n   ➔ Déblocage séquestre caution CMI & baux juridiques\n5. SUSPENDU (Liveness échec / Fraude avérée) :\n   ➔ Révocation des accès et signalement audit CNDP",
      "lineHeight": 1.35,
      "frameId": null
    },
