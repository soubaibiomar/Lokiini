    {
      "id": "text_83_2700",
      "type": "text",
      "x": 1844,
      "y": 608,
      "width": 563.7599999999999,
      "height": 145.8,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "seed": 619389,
      "version": 1,
      "versionNonce": 377268,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787826153,
      "link": null,
      "locked": false,
      "text": "Columns & Types :\n  • id                 : UUID PRIMARY KEY\n  • user_id            : UUID REFERENCES users(id) ON DELETE CASCADE\n  • event_type         : VARCHAR(100) ('LIVENESS_CHECK' | 'CIN_VERIFY' | 'LOGIN')\n  • audit_proof_sha256 : VARCHAR(64) NOT NULL (Empreinte cryptographique)\n  • declaration_ref    : VARCHAR(100) ('CNDP-DEP-2026-MAROC-89421')\n  • ip_anonymized      : VARCHAR(45) (IPv4/IPv6 masquée)\n  • memory_purged_flag : BOOLEAN DEFAULT TRUE\n  • created_at         : TIMESTAMP WITH TIME ZONE DEFAULT NOW()",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Columns & Types :\n  • id                 : UUID PRIMARY KEY\n  • user_id            : UUID REFERENCES users(id) ON DELETE CASCADE\n  • event_type         : VARCHAR(100) ('LIVENESS_CHECK' | 'CIN_VERIFY' | 'LOGIN')\n  • audit_proof_sha256 : VARCHAR(64) NOT NULL (Empreinte cryptographique)\n  • declaration_ref    : VARCHAR(100) ('CNDP-DEP-2026-MAROC-89421')\n  • ip_anonymized      : VARCHAR(45) (IPv4/IPv6 masquée)\n  • memory_purged_flag : BOOLEAN DEFAULT TRUE\n  • created_at         : TIMESTAMP WITH TIME ZONE DEFAULT NOW()",
      "lineHeight": 1.35,
      "frameId": null
    },
