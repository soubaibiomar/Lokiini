      "isDeleted": false,
      "boundElements": null,
      "updated": 1787826153,
      "link": null,
      "locked": false,
      "text": "• Saisie Email, Password, Nom, Rôle\n• Si Pro : Saisie ICE & Raison Sociale\n• Validation locale des critères de sécurité\n• Envoi HTTPS : POST /api/v1/auth/register\n  ou POST /api/v1/auth/login",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Saisie Email, Password, Nom, Rôle\n• Si Pro : Saisie ICE & Raison Sociale\n• Validation locale des critères de sécurité\n• Envoi HTTPS : POST /api/v1/auth/register\n  ou POST /api/v1/auth/login",
      "lineHeight": 1.35,
      "frameId": null
    },
