    },
    {
      "id": "text_45_1021",
      "type": "text",
      "x": 624,
      "y": 1028,
      "width": 487.19999999999993,
      "height": 129.60000000000002,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "seed": 421180,
      "version": 1,
      "versionNonce": 745066,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787826153,
      "link": null,
      "locked": false,
      "text": "• Résolution intelligente URL Gateway (Port 80 Nginx / 8000 Dev)\n• authService.login({ email, password }) ➔ JWT Bearer\n• authService.register({ email, password, full_name, role, ... })\n• authService.getCurrentUser() ➔ GET /api/v1/auth/me\n• kycService.verifyCIN({ cin_number, user_id })\n• kycService.verifyBiometrics({ cin_number, liveness_score })\n• Intercepteur Axios injectant 'Authorization: Bearer <token>'\n• Gestion centralisée des erreurs 401 (Auto-déconnexion & redirection)",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• Résolution intelligente URL Gateway (Port 80 Nginx / 8000 Dev)\n• authService.login({ email, password }) ➔ JWT Bearer\n• authService.register({ email, password, full_name, role, ... })\n• authService.getCurrentUser() ➔ GET /api/v1/auth/me\n• kycService.verifyCIN({ cin_number, user_id })\n• kycService.verifyBiometrics({ cin_number, liveness_score })\n• Intercepteur Axios injectant 'Authorization: Bearer <token>'\n• Gestion centralisée des erreurs 401 (Auto-déconnexion & redirection)",
      "lineHeight": 1.35,
      "frameId": null
    },
    {
      "id": "rect_46_4639",
      "type": "rectangle",
      "x": 610,
      "y": 1250,
      "width": 530,
      "height": 220,
      "angle": 0,
