    {
      "id": "text_14_5515",
      "type": "text",
      "x": 79,
      "y": 488,
      "width": 459.35999999999996,
      "height": 113.40000000000002,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
