    {
      "id": "text_10_7361",
      "type": "text",
      "x": 79,
      "y": 278,
      "width": 494.1599999999999,
      "height": 97.20000000000002,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "seed": 519348,
      "version": 1,
      "versionNonce": 608569,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787826153,
      "link": null,
      "locked": false,
      "text": "• UC-01 : Création de compte (Email, Mot de passe, Téléphone, Nom)\n• UC-02 : Connexion par identifiants & réception du JWT Bearer\n• UC-03 : Navigation & recherche sans inscription préalable (SEO Libre)\n• UC-04 : Déclenchement KYC Just-In-Time au moment de Réserver\n• UC-05 : Prise de selfie liveness + scan recto/verso CIN\n• UC-06 : Consultation de l'historique des baux & cautions CMI",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• UC-01 : Création de compte (Email, Mot de passe, Téléphone, Nom)\n• UC-02 : Connexion par identifiants & réception du JWT Bearer\n• UC-03 : Navigation & recherche sans inscription préalable (SEO Libre)\n• UC-04 : Déclenchement KYC Just-In-Time au moment de Réserver\n• UC-05 : Prise de selfie liveness + scan recto/verso CIN\n• UC-06 : Consultation de l'historique des baux & cautions CMI",
      "lineHeight": 1.35,
      "frameId": null
    },
