      "text": "🛡️ FastAPI : Router KYC & Audit (src/backend/app/routers/kyc.py)",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
