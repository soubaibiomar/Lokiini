    {
      "id": "text_33_7905",
      "type": "text",
      "x": 624,
      "y": 278,
      "width": 452.3999999999999,
      "height": 113.40000000000002,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
