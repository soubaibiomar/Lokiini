    {
      "id": "text_79_5729",
      "type": "text",
      "x": 1844,
      "y": 278,
      "width": 556.8,
      "height": 259.20000000000005,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "seed": 285897,
      "version": 1,
      "versionNonce": 101617,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787826153,
      "link": null,
      "locked": false,
      "text": "Columns & Types :\n  • id                 : UUID (Primary Key, default gen_random_uuid())\n  • email              : VARCHAR(255) UNIQUE NOT NULL (Indexé)\n  • hashed_password    : VARCHAR(255) NOT NULL (Argon2 / bcrypt hash)\n  • full_name          : VARCHAR(255) NOT NULL\n  • phone_number       : VARCHAR(50) (Format marocain +212)\n  • role               : VARCHAR(50) NOT NULL ('renter' | 'pro_owner' | 'admin')\n  • company_name       : VARCHAR(255) NULL (Pour Loueurs BTP)\n  • ice_number         : VARCHAR(15) NULL (Identifiant Commun de l'Entreprise)\n  • rc_number          : VARCHAR(100) NULL (Registre du Commerce)\n  • cin_number         : VARCHAR(20) NULL (Chiffré via pgcrypto)\n  • is_kyc_verified    : BOOLEAN DEFAULT FALSE\n  • kyc_liveness_score : NUMERIC(5,2) NULL (ex: 96.80)\n  • kyc_audit_hash     : VARCHAR(64) NULL (Empreinte SHA-256 CNDP)\n  • cndp_consent_at    : TIMESTAMP WITH TIME ZONE NULL\n  • created_at         : TIMESTAMP WITH TIME ZONE DEFAULT NOW()",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Columns & Types :\n  • id                 : UUID (Primary Key, default gen_random_uuid())\n  • email              : VARCHAR(255) UNIQUE NOT NULL (Indexé)\n  • hashed_password    : VARCHAR(255) NOT NULL (Argon2 / bcrypt hash)\n  • full_name          : VARCHAR(255) NOT NULL\n  • phone_number       : VARCHAR(50) (Format marocain +212)\n  • role               : VARCHAR(50) NOT NULL ('renter' | 'pro_owner' | 'admin')\n  • company_name       : VARCHAR(255) NULL (Pour Loueurs BTP)\n  • ice_number         : VARCHAR(15) NULL (Identifiant Commun de l'Entreprise)\n  • rc_number          : VARCHAR(100) NULL (Registre du Commerce)\n  • cin_number         : VARCHAR(20) NULL (Chiffré via pgcrypto)\n  • is_kyc_verified    : BOOLEAN DEFAULT FALSE\n  • kyc_liveness_score : NUMERIC(5,2) NULL (ex: 96.80)\n  • kyc_audit_hash     : VARCHAR(64) NULL (Empreinte SHA-256 CNDP)\n  • cndp_consent_at    : TIMESTAMP WITH TIME ZONE NULL\n  • created_at         : TIMESTAMP WITH TIME ZONE DEFAULT NOW()",
      "lineHeight": 1.35,
      "frameId": null
    },
