    {
      "id": "text_105_8592",
      "type": "text",
      "x": 589,
      "y": 1638,
      "width": 327.11999999999995,
      "height": 81.00000000000001,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
