      "lineHeight": 1.35,
      "frameId": null
    },
    {
      "id": "text_60_6763",
      "type": "text",
      "x": 1224,
      "y": 538,
      "width": 466.31999999999994,
      "height": 129.60000000000002,
      "angle": 0,
      "strokeColor": "#334155",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "seed": 71091,
      "version": 1,
      "versionNonce": 47688,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787826153,
      "link": null,
      "locked": false,
      "text": "• POST /api/v1/kyc/verify-cin :\n   - Contrôle regex CIN marocaine ([A-Z]{1,2}[0-9]{5,6})\n   - Extraction automatique de la préfecture d'émission\n• POST /api/v1/kyc/liveness-check :\n   - Analyse biométrique ISO/IEC 30107-3 PAD Niveau 2\n   - Génération du jeton d'audit cryptographique CNDP (SHA-256)\n   - Mise à jour atomique de l'utilisateur : is_kyc_verified = True\n• GET /api/v1/kyc/status/{user_id} : Vérification d'état d'audit",
      "fontSize": 12,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "• POST /api/v1/kyc/verify-cin :\n   - Contrôle regex CIN marocaine ([A-Z]{1,2}[0-9]{5,6})\n   - Extraction automatique de la préfecture d'émission\n• POST /api/v1/kyc/liveness-check :\n   - Analyse biométrique ISO/IEC 30107-3 PAD Niveau 2\n   - Génération du jeton d'audit cryptographique CNDP (SHA-256)\n   - Mise à jour atomique de l'utilisateur : is_kyc_verified = True\n• GET /api/v1/kyc/status/{user_id} : Vérification d'état d'audit",
      "lineHeight": 1.35,
      "frameId": null
    },
