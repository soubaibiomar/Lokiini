    },
    {
      "id": "text_957069",
      "type": "text",
      "x": 76,
      "y": 1435.85,
      "width": 1499.3,
      "height": 14.85,
      "angle": 0,
      "strokeColor": "#1E293B",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 101061,
      "version": 1,
      "versionNonce": 498602,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787773645274,
      "link": null,
      "locked": false,
      "text": "📌 POURQUOI (WHY) : Capter les 80%+ de demandes de location initiées sur WhatsApp au Maroc (en Darija ou Français) et transformer une simple discussion informelle en réservation ferme avec paiement / caution CMI en moins de 60 secondes.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 9.35,
      "containerId": null,
      "originalText": "📌 POURQUOI (WHY) : Capter les 80%+ de demandes de location initiées sur WhatsApp au Maroc (en Darija ou Français) et transformer une simple discussion informelle en réservation ferme avec paiement / caution CMI en moins de 60 secondes.",
      "lineHeight": 1.25
    },
    {
      "id": "text_219743",
      "type": "text",
      "x": 76,
