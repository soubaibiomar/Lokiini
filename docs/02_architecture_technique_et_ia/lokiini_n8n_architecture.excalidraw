      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 10.2,
      "containerId": null,
      "originalText": "💡 EXPLICATION MÉTIER & TECHNIQUE (POURQUOI & COMMENT) :",
