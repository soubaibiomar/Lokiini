      "version": 1,
      "versionNonce": 855926,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787773645274,
      "link": null,
      "locked": false,
      "text": "💡 EXPLICATION MÉTIER & TECHNIQUE (POURQUOI & COMMENT) :",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 10.2,
      "containerId": null,
      "originalText": "💡 EXPLICATION MÉTIER & TECHNIQUE (POURQUOI & COMMENT) :",
      "lineHeight": 1.25
    },
    {
      "id": "text_369207",
      "type": "text",
      "x": 76,
      "y": 940.85,
      "width": 1263.24,
      "height": 14.85,
      "angle": 0,
      "strokeColor": "#1E293B",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 701045,
      "version": 1,
      "versionNonce": 735662,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787773645274,
      "link": null,
      "locked": false,
      "text": "📌 POURQUOI (WHY) : Empêcher les usurpations d'identité et les vols de matériel tout en respectant strictement la Loi 09-08 de la CNDP interdisant le stockage permanent de vidéos biométriques brutes.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 9.35,
      "containerId": null,
      "originalText": "📌 POURQUOI (WHY) : Empêcher les usurpations d'identité et les vols de matériel tout en respectant strictement la Loi 09-08 de la CNDP interdisant le stockage permanent de vidéos biométriques brutes.",
      "lineHeight": 1.25
    },
    {
      "id": "text_450968",
      "type": "text",
      "x": 76,
      "y": 959.7,
      "width": 1435.5,
      "height": 14.85,
      "angle": 0,
      "strokeColor": "#1E293B",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 969047,
      "version": 1,
      "versionNonce": 481258,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787773645274,
      "link": null,
      "locked": false,
      "text": "⚙️ COMMENT (HOW) : Analyse OCR de la CIN + test de vivacité anti-deepfake. Si score >= 85%, validation PostgreSQL, envoi de confirmation WhatsApp et purge immédiate des vidéos de la mémoire vive (Zero-Knowledge Architecture).",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 9.35,
      "containerId": null,
      "originalText": "⚙️ COMMENT (HOW) : Analyse OCR de la CIN + test de vivacité anti-deepfake. Si score >= 85%, validation PostgreSQL, envoi de confirmation WhatsApp et purge immédiate des vidéos de la mémoire vive (Zero-Knowledge Architecture).",
      "lineHeight": 1.25
    },
