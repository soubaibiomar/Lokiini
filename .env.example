# Copy this file to .env for local development, then generate unique values.
# Never deploy values copied from another environment.

ENVIRONMENT=development
DEBUG=false

# PostgreSQL (required; generate a unique password locally)
POSTGRES_DB=lokiini_db
POSTGRES_USER=lokiini_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=

# Internal services
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_MASTER_KEY=
MEILISEARCH_PORT=7700
MEILI_ENV=development

# Backend identity and session configuration
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_SESSION_COOKIE_NAME=lokiini_session
FIREBASE_SESSION_DAYS=5
SESSION_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3001
API_BASE_URL=http://localhost

# Didit KYC (key, webhook secret and workflow ID must be provided together)
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=
DIDIT_API_URL=https://verification.didit.me/v3

# n8n (the encryption key is mandatory in staging and production)
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost/n8n/
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_BASE_URL=http://n8n:5678/webhook
N8N_WEBHOOK_AUTH_TOKEN=
GENERIC_TIMEZONE=Africa/Casablanca

# Payment providers are disabled. Leave empty until the integrations are enabled.
CMI_CLIENT_ID=
CMI_STORE_KEY=
CASHPLUS_API_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# Public web configuration only. Every VITE_ value is delivered to the browser.
VITE_API_URL=/api/v1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional development port overrides
GATEWAY_PORT=80
FRONTEND_PORT=3001
BACKEND_PORT=8001
