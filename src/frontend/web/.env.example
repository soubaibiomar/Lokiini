# ==============================================================================
# LOKIINI WEB FRONTEND — CONFIGURATION DES VARIABLES D'ENVIRONNEMENT
# ==============================================================================

# 1. Base URL API Backend (FastAPI)
VITE_API_URL=http://localhost:8000/api/v1

# 2. Firebase Authentication Credentials (Console Firebase > Paramètres du projet > Général)
VITE_FIREBASE_API_KEY=votre_cle_api_firebase
VITE_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=votre-projet-id
VITE_FIREBASE_STORAGE_BUCKET=votre-projet.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
